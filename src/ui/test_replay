"""
test_replay.py

Replays a .fif session through the classifier worker pipeline
without any LSL stream or hardware. Simulates feedback button
presses automatically based on ground truth labels.

Run from the ui/ directory:
    python test_replay.py
"""

import sys
import os
import time
import numpy as np
import torch
import mne

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))

from ml_model import models
from eeg_recorder import EEGRecorder, CH_NAMES

# ── Config ────────────────────────────────────────────────────────────────────

FIF_PATH   = "../data_collection/annotated_eeg/chengyi_4_21_1.fif"
MODEL_PATH = "../models/DeepConvNet_whole_file.pt"

SFREQ        = 300
STRIDE_SEC   = 1
STRIDE_SAMP  = SFREQ * STRIDE_SEC    # 300 samples per stride
CALIB_SAMP   = SFREQ * 60            # 60s calibration buffer
TRIAL_SAMP   = SFREQ * 3 + 1         # 901 samples per trial window
BANDPASS     = (13, 30)
LABEL_MAP    = {0: "idle", 1: "move", 2: "jaw_clench"}
MOVE_THRESH  = 0.95

EXCLUDE      = {"Trigger", "Event"}

# ── Load the .fif as a fake stream ────────────────────────────────────────────

def load_fif_as_stream(fif_path):
    """
    Reads the raw .fif and returns:
      data:        (n_channels, n_samples) float32 — the raw EEG
      sfreq:       int
      ch_names:    list of str
      events:      list of (sample_idx, label_str) for ground truth
    """
    raw = mne.io.read_raw_fif(fif_path, preload=True, verbose=False)
    ch_names = [ch for ch in raw.ch_names if ch not in EXCLUDE]
    data     = raw.get_data(picks=ch_names).astype(np.float32)
    sfreq    = int(raw.info['sfreq'])

    # Extract ground truth events from annotations
    label_map_inv = {'idle': 0, 'move': 1, 'jaw_clench': 2}
    events = []
    for ann in raw.annotations:
        label = ann['description']
        if label in label_map_inv:
            onset_samp = int(ann['onset'] * sfreq)
            events.append((onset_samp, label))

    print(f"[Replay] Loaded: {data.shape}  sfreq={sfreq}Hz  "
          f"duration={data.shape[1]/sfreq:.1f}s")
    print(f"[Replay] Ground truth events: "
          f"{ {l: sum(1 for _,ll in events if ll==l) for l in label_map_inv} }")

    return data, sfreq, ch_names, events


# ── Preprocessing (mirrors classifier_worker_calibration.preprocess_buffer) ──

def preprocess_buffer(buffer: np.ndarray) -> torch.Tensor:
    """Filter full rolling buffer, extract last TRIAL_SAMP samples."""
    info = mne.create_info(ch_names=CH_NAMES, sfreq=SFREQ, ch_types="eeg")
    raw  = mne.io.RawArray(buffer, info, verbose=False)
    raw.notch_filter(60.0, verbose=False)
    raw.filter(BANDPASS[0], BANDPASS[1], verbose=False)
    raw.set_eeg_reference(ref_channels="average", verbose=False)

    X    = raw.get_data()[:, -TRIAL_SAMP:]
    mean = X.mean(axis=-1, keepdims=True)
    std  = X.std(axis=-1,  keepdims=True) + 1e-8
    X    = (X - mean) / std
    return torch.from_numpy(X).float().unsqueeze(0).unsqueeze(0)


# ── Load model ────────────────────────────────────────────────────────────────

def load_model():
    model = models.DeepConvNet(8, 2).to("cpu")
    model.load_state_dict(torch.load(MODEL_PATH, map_location="cpu"))
    model.eval()
    print(f"[Replay] Model loaded from {MODEL_PATH}")
    return model


# ── Ground truth oracle — simulates feedback button presses ──────────────────

class FeedbackOracle:
    """
    Looks up the ground truth label at the current timestamp and
    automatically decides correct/wrong, simulating the user pressing
    ✓ or ✗ on every prediction.

    You can also set auto=False and call .decide(pred) manually
    to test specific scenarios.
    """
    def __init__(self, events, sfreq, auto=True):
        self.events = events   # [(sample_idx, label_str)]
        self.sfreq  = sfreq
        self.auto   = auto
        self._decisions = []

    def evaluate(self, pred_label: str, current_sample: int) -> bool:
        """
        Returns True (correct) if the predicted label matches the
        ground truth at the current sample position.
        """
        if not self.auto:
            return True   # always confirm if not auto

        # Find closest ground truth event within ±1.5s
        window = self.sfreq * 1.5
        nearby = [
            label for samp, label in self.events
            if abs(samp - current_sample) <= window
        ]

        if not nearby:
            # No event nearby — ground truth is idle
            correct = (pred_label == "idle" or pred_label == "other")
        else:
            # Use the most recent nearby event
            correct = any(pred_label == lbl for lbl in nearby)

        self._decisions.append((pred_label, nearby, correct))
        return correct

    def summary(self):
        correct = sum(1 for _, _, c in self._decisions if c)
        total   = len(self._decisions)
        print(f"\n[Oracle] Feedback summary: "
              f"{correct}/{total} correct  ({correct/max(total,1):.1%})")


# ── Main replay loop ──────────────────────────────────────────────────────────

def run_replay(auto_feedback=True, speed_multiplier=10.0):
    """
    speed_multiplier: how much faster than real time to replay.
                      10.0 = 10× speed (1 hour session in 6 minutes)
                      1.0  = real time
                      None = as fast as possible
    """
    data, sfreq, ch_names, events = load_fif_as_stream(FIF_PATH)
    model                          = load_model()
    oracle                         = FeedbackOracle(events, sfreq, auto=auto_feedback)

    recorder = EEGRecorder(
        sfreq            = SFREQ,
        ch_names         = CH_NAMES,
        gdrive_folder_id = None,      # set your folder ID here to also upload
        local_dir        = "./live_eeg_test",
    )

    n_total_samples  = data.shape[1]
    rolling_buffer   = np.zeros((len(ch_names), 0), dtype=np.float32)
    calibrated       = False
    current_sample   = 0

    correct_preds    = 0
    total_preds      = 0
    results_log      = []

    print(f"\n[Replay] Starting replay at {speed_multiplier}× speed...")
    print(f"[Replay] Total samples: {n_total_samples}  "
          f"({n_total_samples/sfreq:.1f}s)\n")

    recorder.start()

    while current_sample < n_total_samples:

        # Slice one stride
        end_sample  = min(current_sample + STRIDE_SAMP, n_total_samples)
        stride_data = data[:, current_sample:end_sample]

        # Feed raw data into recorder (same as live)
        recorder.append(stride_data)

        # Append to rolling buffer
        rolling_buffer = np.concatenate([rolling_buffer, stride_data], axis=1)
        if rolling_buffer.shape[1] > CALIB_SAMP:
            rolling_buffer = rolling_buffer[:, -CALIB_SAMP:]

        # Calibration phase
        if not calibrated:
            pct = rolling_buffer.shape[1] / CALIB_SAMP * 100
            if rolling_buffer.shape[1] >= CALIB_SAMP:
                calibrated = True
                print(f"[Replay] ✓ Calibration complete at sample {current_sample}")
            else:
                print(f"[Replay] Calibrating... {pct:.0f}%")
            current_sample = end_sample
            if speed_multiplier:
                time.sleep(STRIDE_SEC / speed_multiplier)
            continue

        # Inference
        x = preprocess_buffer(rolling_buffer)
        if torch.isnan(x).any():
            current_sample = end_sample
            continue

        with torch.no_grad():
            output = model(x)
            pred   = output.argmax(1).item()
            conf   = output[0, pred].item()

        pred_label = LABEL_MAP.get(pred, "?")
        fired      = conf >= MOVE_THRESH

        # Annotate prediction in recorder
        recorder.annotate_prediction(pred, conf)

        # Simulate feedback button press
        correct = oracle.evaluate(pred_label, current_sample)
        recorder.annotate_feedback(correct=correct)

        total_preds += 1
        correct_preds += int(correct)

        status = "✓" if correct else "✗"
        print(f"  t={current_sample/sfreq:6.1f}s  "
              f"pred={pred_label:<12} conf={conf:.2f}  "
              f"fired={'YES' if fired else 'no ':4s}  "
              f"feedback={status}")

        results_log.append({
            'time_sec'  : current_sample / sfreq,
            'pred'      : pred_label,
            'conf'      : conf,
            'fired'     : fired,
            'correct'   : correct,
        })

        current_sample = end_sample

        if speed_multiplier:
            time.sleep(STRIDE_SEC / speed_multiplier)

    # ── Session complete ───────────────────────────────────────────────────────

    recorder.stop()
    print(f"\n[Replay] Inference complete.")
    print(f"[Replay] Predictions: {total_preds}  "
          f"Correct: {correct_preds}  "
          f"({correct_preds/max(total_preds,1):.1%})")

    oracle.summary()

    saved_path = recorder.save(subject_id="chengyi_4_21_replay")
    print(f"\n[Replay] Saved annotated session: {saved_path}")

    # Print a results summary
    _print_summary(results_log)

    return saved_path, results_log


def _print_summary(results_log):
    if not results_log:
        return

    fired      = [r for r in results_log if r['fired']]
    not_fired  = [r for r in results_log if not r['fired']]
    correct    = [r for r in results_log if r['correct']]

    print(f"\n{'='*50}")
    print("REPLAY SUMMARY")
    print(f"{'='*50}")
    print(f"Total inference steps : {len(results_log)}")
    print(f"Fired (conf≥{MOVE_THRESH}) : {len(fired)}")
    print(f"Below threshold       : {len(not_fired)}")
    print(f"Feedback correct      : {len(correct)} / {len(results_log)} "
          f"({len(correct)/max(len(results_log),1):.1%})")

    # Confidence distribution
    confs = [r['conf'] for r in results_log]
    print(f"\nConfidence stats:")
    print(f"  mean  {np.mean(confs):.3f}")
    print(f"  median {np.median(confs):.3f}")
    print(f"  min   {np.min(confs):.3f}")
    print(f"  max   {np.max(confs):.3f}")

    # Per-class breakdown
    print(f"\nPredictions by class:")
    for label in ["idle", "move", "jaw_clench", "other"]:
        count = sum(1 for r in results_log if r['pred'] == label)
        if count:
            print(f"  {label:<12}: {count}")


# ── Entry point ────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    saved_path, log = run_replay(
        auto_feedback    = True,   # True = oracle decides correct/wrong automatically
        speed_multiplier = 10.0,   # 10× real time
    )